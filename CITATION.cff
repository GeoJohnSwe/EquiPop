cff-version: 1.2.0
message: "If you use EquiPop in your research, please cite the software report below and the methods papers relevant to the functions you use."
title: "EquiPop (Python)"
type: software
authors:
  # ONE author entry, three affiliations in one string (John's
  # ruling). CFF allows only one `affiliation` per author, so the
  # alternative was three entries - which renders as three authors in
  # some tools. Other addresses: john_eric_david.gardmark_osth@keg.lu.se
  # (Lund), john.osth@ibf.uu.se (Uppsala).
  - family-names: "Östh"
    given-names: "John"
    orcid: "https://orcid.org/0000-0002-4536-9229"
    affiliation: "OsloMet - Oslo Metropolitan University, Oslo, Norway; Lund University, Lund, Sweden; Uppsala University, Uppsala, Sweden"
    email: "johnosth@oslomet.no"
license: MIT
repository-code: "https://github.com/GeoJohnSwe/EquiPop"
# BACKLOG 43. This sat at 1.0.0 for forty releases because nothing
# checked it. It is an EIGHTH place a version string lives, and
# tests/test_doctor.py now asserts it against the package. The
# preferred-citation below is the 2014 report and does NOT move with
# the software version.
version: 1.63.1
preferred-citation:
  type: report
  title: "Introducing the EquiPop software: An application for the calculation of k-nearest neighbour contexts/neighbourhoods"
  authors:
    - family-names: "Östh"
      given-names: "John"
  year: 2014
  institution:
    # the affiliation AT THE TIME OF THE 2014 REPORT - a citation
    # records where a work was written and is not updated when an
    # author moves.
    name: "Uppsala University, Department of Social and Economic Geography"
  location:
    name: "Uppsala, Sweden"
references:
  - type: article
    title: "Measuring the scale of segregation using k-nearest neighbor aggregates"
    authors:
      - family-names: "Östh"
        given-names: "John"
      - family-names: "Clark"
        given-names: "William A. V."
      - family-names: "Malmberg"
        given-names: "Bo"
    journal: "Geographical Analysis"
    volume: 47
    issue: 1
    start: 34
    end: 49
    year: 2015
  - type: article
    title: "A new way of determining distance decay parameters in spatial interaction models with application to job accessibility analysis in Sweden"
    authors:
      - family-names: "Östh"
        given-names: "John"
      - family-names: "Lyhagen"
        given-names: "Johan"
      - family-names: "Reggiani"
        given-names: "Aura"
    journal: "European Journal of Transport and Infrastructure Research"
