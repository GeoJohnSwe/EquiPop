__pycache__/
*.pyc
dist/
.pytest_cache/

# BACKLOG 350 (v1.51.1): a release shipped a second, stale copy of the
# package because `build/` was not ignored and so was committable. Build
# outputs and the metadata pip writes for an editable install never
# belong in the repository.
build/
*.egg-info/

# Caches written by type checkers and linters.
.mypy_cache/
.ruff_cache/

# BACKLOG 350: the ArcGIS Pro help sidecars are GENERATED by
# arcgis/make_help_xml.py at bundle time (tools/make_bundle.sh, step 1)
# and must not be committed; tests/test_packaging.py fails if they are
# left in the tree, and this line says so before the test has to.
arcgis/*.pyt.xml

# BACKLOG 460 (review of 1.63.2, M1): these rules were in the release
# trees but not in the repository, so a tree rebuilt from a clone lost
# them. tests/test_gitignore.py now keeps them.
